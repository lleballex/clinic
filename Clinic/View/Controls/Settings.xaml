<UserControl x:Class="Clinic.View.Controls.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Clinic.View.Controls"
             mc:Ignorable="d" 
             d:Style="{StaticResource ControlDesignStyle}">
    <StackPanel Margin="0,0,0,-16">
        <StackPanel Margin="0,0,0,16">
            <Label Margin="0,0,0,8">Цвет фона ProgressBar</Label>
            <TextBox Text="{Binding FormSecondaryBackground}" />
        </StackPanel>
        <StackPanel Margin="0,0,0,16">
            <Label Margin="0,0,0,8">Цвет заполненного фона ProgressBar</Label>
            <TextBox Text="{Binding FormPrimaryBackground}" />
        </StackPanel>
        <StackPanel Margin="0,0,0,16">
            <Label Margin="0,0,0,8">Цвет рамки ProgressBar</Label>
            <TextBox Text="{Binding FormBorder}" />
        </StackPanel>
    </StackPanel>
</UserControl>
